<!-- Used by the Docker build: fetch dependencies from Google's Maven Central mirror,
     which doesn't rate-limit shared build hosts like Render the way repo.maven.apache.org does -->
<settings>
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google Maven Central mirror</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
